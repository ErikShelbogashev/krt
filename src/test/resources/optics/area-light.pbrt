# A matte receiver and an off-axis square emitter. Both renderers read this file.
Scale -1 1 1
LookAt 0 0 2  0 0 0  0 1 0
Camera "perspective" "float fov" [44] "float lensradius" [0]
Film "rgb" "integer xresolution" [64] "integer yresolution" [64]
PixelFilter "box"
Sampler "zsobol" "integer pixelsamples" [1024]
Integrator "path" "integer maxdepth" [2]
WorldBegin

AttributeBegin
  Material "diffuse" "rgb reflectance" [0.7 0.7 0.7]
  Shape "trianglemesh" "point3 P" [-2 -2 0   2 -2 0   2 2 0   -2 2 0] "integer indices" [0 1 2  0 2 3]
AttributeEnd

AttributeBegin
  AreaLightSource "diffuse" "rgb L" [1 1 1]
  Material "diffuse" "rgb reflectance" [0 0 0]
  Shape "trianglemesh" "point3 P" [0.65 -0.25 0.8   0.65 0.25 0.8   1.15 0.25 0.8   1.15 -0.25 0.8] "integer indices" [0 1 2  0 2 3]
AttributeEnd
