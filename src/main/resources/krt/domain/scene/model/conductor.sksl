// ConductorFresnel.reflectance: exact unpolarised Fresnel of a metal of complex index eta + i k, per channel.
float3 conductorFresnel(float cosine, float3 eta, float3 k) {
    float cos2 = cosine * cosine;
    float sin2 = 1.0 - cos2;
    float3 t0 = eta * eta - k * k - sin2;
    float3 a2b2 = sqrt(t0 * t0 + 4.0 * eta * eta * k * k);
    float3 a = sqrt(max(float3(0.0), (a2b2 + t0) * 0.5));
    float3 t1 = a2b2 + cos2;
    float3 t2 = 2.0 * a * cosine;
    float3 rs = (t1 - t2) / (t1 + t2);
    float3 t3 = cos2 * a2b2 + sin2 * sin2;
    float3 t4 = t2 * sin2;
    float3 rp = rs * (t3 - t4) / (t3 + t4);
    return (rs + rp) * 0.5;
}
