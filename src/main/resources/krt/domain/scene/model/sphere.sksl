// Sphere.centerAt: the centre of the ball at [base] at the moment of the path; moving balls only with motion blur.
float3 centerOf(float base) {
    float3 center = vector(base + 1.0);
    if (motionBlur > 0.5) { center += vector(base + 5.0) * rayTime; }
    return center;
}

// SphereRoots.discriminant: a distant small sphere can disappear in halfB² - a*c in float32.
float sphereDiscriminant(float3 oc, float3 direction, float a, float halfB, float radius) {
    float square = halfB * halfB;
    float difference = square - a * (dot(oc, oc) - radius * radius);
    if (abs(difference) > square * 0.001) { return difference; }
    float3 offset = cross(oc, direction);
    return a * radius * radius - dot(offset, offset);
}
