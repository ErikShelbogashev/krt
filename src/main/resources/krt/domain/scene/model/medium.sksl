float3 mediumDensity(float medium) { return positiveVector(mediaStart + medium * MEDIUM_VALUES); }

float3 mediumAlbedo(float medium) { return vector(mediaStart + medium * MEDIUM_VALUES + 3.0); }

float mediumG(float medium) { return number(mediaStart + medium * MEDIUM_VALUES + 6.0) / RANGE; }

// HenyeyGreenstein.density: the share of scattered light per steradian at [cosine] from the incoming direction.
float phaseDensity(float cosine, float g) {
    float magnitude = abs(g);
    float angle = clamp(cosine, -1.0, 1.0);
    float separation = g < 0.0 ? 1.0 + angle : 1.0 - angle;
    float gap = 1.0 - magnitude;
    float d = gap * gap + 2.0 * magnitude * separation;
    return gap * (1.0 + magnitude) / (4.0 * PI * d * sqrt(d));
}

// HenyeyGreenstein.sample: a direction scattered from the unit [incoming] direction, drawn in proportion to it.
float3 phaseSample(float3 incoming, float g) {
    float u = rnd();
    float v = rnd();
    float cosine;
    if (abs(g) < 0.001) {
        float t = 2.0 * u - 1.0;
        float d = 1.0 + g * t;
        cosine = (t * (1.0 + g * g) + 0.5 * g * (3.0 + t * t + g * g * (t * t - 1.0))) / (d * d);
    } else {
        float s = (1.0 - g * g) / (1.0 - g + 2.0 * g * u);
        cosine = clamp((1.0 + g * g - s * s) / (2.0 * g), -1.0, 1.0);
    }
    float sine = sqrt(max(0.0, 1.0 - cosine * cosine));
    float phi = 2.0 * PI * v;
    float3 axis = abs(incoming.y) < 0.999 ? float3(0.0, 1.0, 0.0) : float3(1.0, 0.0, 0.0);
    float3 tangent = normalize(cross(axis, incoming));
    float3 bitangent = cross(incoming, tangent);
    return incoming * cosine + (tangent * cos(phi) + bitangent * sin(phi)) * sine;
}

// The medium beyond the surface of primitive [slot] for a ray that passes it [frontFace] first, as PathTracing.after:
// 1 + its number in the primitive's record, the inside one through the front, the outside one through the back.
float mediumBeyond(float slot, bool frontFace) {
    float base = primitiveStart + slot * PRIMITIVE_VALUES;
    return code(base + (frontFace ? 12.0 : 13.0)) - 1.0;
}

bool boundsMedia(float slot) {
    float base = primitiveStart + slot * PRIMITIVE_VALUES;
    return code(base + 12.0) + code(base + 13.0) > 0.0;
}

// FreeFlight.distance: the distance to the next particle, with the density of one channel picked at random.
float freeDistance(float3 density) {
    float pick = rnd();
    float channel = pick < 1.0 / 3.0 ? density.x : (pick < 2.0 / 3.0 ? density.y : density.z);
    float u = rnd();
    return channel > 0.0 ? -log(1.0 - u) / channel : FAR;
}

// FreeFlight weights are relative channel probabilities. Cancel the common exponential if the
// individual probabilities approach the float subnormal range (some devices flush it to zero).
float3 mixtureWeight(float3 density, float distance, bool scatter) {
    float3 coefficient = scatter ? density : float3(1.0);
    float3 rates = coefficient * exp(-density * distance);
    float sum = rates.x + rates.y + rates.z;
    if (sum < 1.0e-36) {
        float3 active = scatter ? float3(
            density.x > 0.0 ? density.x : FAR,
            density.y > 0.0 ? density.y : FAR,
            density.z > 0.0 ? density.z : FAR) : density;
        float lowest = min(active.x, min(active.y, active.z));
        rates = coefficient * exp(-(active - lowest) * distance);
        sum = rates.x + rates.y + rates.z;
    }
    // Large finite extinction can overflow the sum of three finite PDFs. Their common scale cancels.
    if (sum > 1.0e38) {
        rates *= 0.25;
        sum = rates.x + rates.y + rates.z;
    }
    return sum > 0.0 ? rates / (sum / 3.0) : float3(0.0);
}

// PathTracing.transmittance: the share of light along a unit [direction] over [distance] from [origin] in [medium]:
// none past a solid surface; through media and their interfaces, what the media let through.
float3 transmittance(float3 origin, float3 direction, float distance, float medium) {
    float3 share = float3(1.0);
    float remaining = distance;
    for (int crossing = 0; crossing <= MAX_SHADOW_CROSSINGS; crossing++) {
        float slot = closestHit(origin, direction, remaining);
        if (slot < 0.0) {
            return medium >= 0.0 ? share * exp(-mediumDensity(medium) * remaining) : share;
        }
        if (crossing == MAX_SHADOW_CROSSINGS || code(materialStart + slot * MATERIAL_VALUES) != INTERFACE) {
            return float3(0.0);
        }
        if (medium >= 0.0) { share *= exp(-mediumDensity(medium) * hitT); }
        float3 p = origin + direction * hitT;
        medium = mediumBeyond(slot, dot(direction, outwardNormal(slot, p)) < 0.0);
        remaining -= hitT;
        origin = p;
    }
    return float3(0.0);
}
