// A sample gone NaN or infinite, from a zero density deep in a medium, is dropped: on some GPUs it would come out
// of the clamps below as any colour at all, a magenta band.
float3 finiteOrBlack(float3 c) {
    bool finite = all(equal(c, c)) && max(c.r, max(c.g, c.b)) < 1e30 && min(c.r, min(c.g, c.b)) > -1e30;
    return finite ? c : float3(0.0);
}

half4 main(float2 position) {
    if (position.x >= frameSize.x) { return half4(stepMarker, 1.0 - stepMarker, 0.0, 1.0); }
    if (position.y < bandStart || position.y >= bandEnd) { return previous.eval(position); }
    float i = floor(position.x);
    float j = frameSize.y - 1.0 - floor(position.y);
    pixelId = float2(i, j);
    counter = 0.0;

    float3 sum = float3(0.0);
    for (int n = 0; n < MAX_SAMPLES; n++) {
        if (float(n) >= samples) { break; }
        float s = (i + rnd()) / (frameSize.x - 1.0);
        float t = (j + rnd()) / (frameSize.y - 1.0);
        float2 rd = randomInUnitDisk() * lensRadius;
        float3 offset = camU * rd.x + camV * rd.y;
        float3 origin = camOrigin + offset;
        float3 direction = camLowerLeft + camHorizontal * s + camVertical * t - camOrigin - offset;
        sum += finiteOrBlack(trace(origin, direction));
    }
    // The earlier steps' frame holds the square root of their mean (gamma 2): back to linear, add, average.
    half4 prior = previous.eval(position);
    float3 earlier = packedWindow > 0.5 ? unpackRadiance(prior) : float3(prior.rgb);
    float taken = clamp(samples, 1.0, float(MAX_SAMPLES));
    float3 mean = (earlier * earlier * previousSamples + sum) / (previousSamples + taken);
    float3 color = sqrt(max(mean, 0.0));
    color = min(color, float3(65504.0));
    return packedWindow > 0.5 ? packRadiance(color) : half4(half3(color), 1.0);
}
