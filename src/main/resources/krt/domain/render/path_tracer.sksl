// GPU path tracer of krt (ADR 0009). Mirrors krt.domain.trace.PathTracing and the materials of the scene model.
// SkSL is GLSL ES 2.0: no recursion, loops have constant bounds and stop early with break, and local arrays take
// constant indices only, so the BVH is walked without a stack along skip links (see krt.domain.trace.FlatBvh).

uniform shader scene;               // RGBA_8888, one 24-bit number per texel, see GpuScene
uniform float nodeCount;
uniform float primitiveStart;
uniform float materialStart;
uniform float2 frameSize;
uniform float3 camOrigin;
uniform float3 camLowerLeft;
uniform float3 camHorizontal;
uniform float3 camVertical;
uniform float3 camU;
uniform float3 camV;
uniform float lensRadius;
uniform float maxDepth;
uniform float samples;
uniform float seed;

const int MAX_DEPTH = 32;
const int MAX_SAMPLES = 64;
const int MAX_STEPS = 65536;        // nodes one ray may visit
const int LEAF_SIZE = 4;            // Bvh.LEAF_SIZE
const float TEXTURE_WIDTH = 1024.0;
const float RANGE = 4096.0;
const float NODE_VALUES = 9.0;
const float PRIMITIVE_VALUES = 10.0;
const float MATERIAL_VALUES = 5.0;
const float T_MIN = 0.001;
const float FAR = 1.0e30;
const float PI = 3.14159265358979;

const float SPHERE = 0.0;

const float LAMBERT = 0.0;
const float METAL = 1.0;
const float DIELECTRIC = 2.0;
const float EMISSIVE = 3.0;

// The 24-bit number at texel [index], as is: an index, a count or a code.
float code(float index) {
    float y = floor(index / TEXTURE_WIDTH);
    float x = index - y * TEXTURE_WIDTH;
    half4 c = scene.eval(float2(x + 0.5, y + 0.5));
    float r = floor(float(c.r) * 255.0 + 0.5);
    float g = floor(float(c.g) * 255.0 + 0.5);
    float b = floor(float(c.b) * 255.0 + 0.5);
    return r * 65536.0 + g * 256.0 + b;
}

// The fixed-point coordinate at texel [index].
float number(float index) {
    return code(index) / 16777216.0 * (2.0 * RANGE) - RANGE;
}

float3 vector(float index) {
    return float3(number(index), number(index + 1.0), number(index + 2.0));
}

// Hash without sine (Dave Hoskins): a pseudo-random number in [0, 1) from three floats.
float hash13(float3 p3) {
    p3 = fract(p3 * 0.1031);
    p3 += dot(p3, p3.zyx + 31.32);
    return fract((p3.x + p3.y) * p3.z);
}

float2 pixelId;
float counter;

float rnd() {
    counter += 1.0;
    return hash13(float3(pixelId.x + seed * 17.0, pixelId.y + seed * 31.0, counter));
}

float3 randomInUnitSphere() {
    float z = 2.0 * rnd() - 1.0;
    float phi = 2.0 * PI * rnd();
    float r = sqrt(max(0.0, 1.0 - z * z));
    float scale = pow(rnd(), 1.0 / 3.0);
    return float3(r * cos(phi), r * sin(phi), z) * scale;
}

float2 randomInUnitDisk() {
    float phi = 2.0 * PI * rnd();
    return float2(cos(phi), sin(phi)) * sqrt(rnd());
}

float reflectance(float cosine, float refIdx) {
    float r0 = (1.0 - refIdx) / (1.0 + refIdx);
    r0 = r0 * r0;
    return r0 + (1.0 - r0) * pow(1.0 - cosine, 5.0);
}

float3 refractDir(float3 uv, float3 n, float etaiOverEtat) {
    float cosTheta = min(dot(-uv, n), 1.0);
    float3 rOutPerp = (uv + n * cosTheta) * etaiOverEtat;
    float3 rOutParallel = n * (-sqrt(abs(1.0 - dot(rOutPerp, rOutPerp))));
    return rOutPerp + rOutParallel;
}

float3 sky(float3 direction) {
    float t = 0.5 * (normalize(direction).y + 1.0);
    return float3(1.0) * (1.0 - t) + float3(0.5, 0.7, 1.0) * t;
}

// Distance along the ray to primitive [slot] within [T_MIN, tMax], or -1 when the ray misses it.
float intersect(float slot, float3 origin, float3 direction, float tMax) {
    float base = primitiveStart + slot * PRIMITIVE_VALUES;
    float3 center = vector(base + 1.0);
    float radius = number(base + 4.0);
    float3 oc = origin - center;
    float a = dot(direction, direction);
    float halfB = dot(oc, direction);
    float c = dot(oc, oc) - radius * radius;
    float discriminant = halfB * halfB - a * c;
    if (discriminant < 0.0) { return -1.0; }
    float sqrtD = sqrt(discriminant);
    float root = (-halfB - sqrtD) / a;
    if (root < T_MIN || root > tMax) { root = (-halfB + sqrtD) / a; }
    if (root < T_MIN || root > tMax) { return -1.0; }
    return root;
}

// Normal of primitive [slot] at [p], pointing out of it.
float3 outwardNormal(float slot, float3 p) {
    float base = primitiveStart + slot * PRIMITIVE_VALUES;
    return (p - vector(base + 1.0)) / number(base + 4.0);
}

float hitT;

// The primitive the ray hits first, or -1; its distance goes to hitT. Walks the BVH along skip links.
float closestHit(float3 origin, float3 direction) {
    hitT = FAR;
    float hitSlot = -1.0;
    float3 inverse = 1.0 / direction;
    float node = 0.0;
    for (int step = 0; step < MAX_STEPS; step++) {
        if (node >= nodeCount) { break; }
        float base = node * NODE_VALUES;
        float3 t1 = (vector(base) - origin) * inverse;
        float3 t2 = (vector(base + 3.0) - origin) * inverse;
        float3 lo = min(t1, t2);
        float3 hi = max(t1, t2);
        float near = max(max(lo.x, lo.y), max(lo.z, T_MIN));
        float far = min(min(hi.x, hi.y), min(hi.z, hitT));
        if (far < near) {
            node = code(base + 6.0);
        } else {
            float count = code(base + 8.0);
            float first = code(base + 7.0);
            for (int k = 0; k < LEAF_SIZE; k++) {
                if (float(k) >= count) { break; }
                float t = intersect(first + float(k), origin, direction, hitT);
                if (t > 0.0) {
                    hitT = t;
                    hitSlot = first + float(k);
                }
            }
            node += 1.0;
        }
    }
    return hitSlot;
}

float3 trace(float3 origin, float3 direction) {
    float3 throughput = float3(1.0);
    for (int depth = 0; depth < MAX_DEPTH; depth++) {
        if (float(depth) >= maxDepth) { break; }

        float slot = closestHit(origin, direction);
        if (slot < 0.0) { return throughput * sky(direction); }

        float3 p = origin + direction * hitT;
        float3 outward = outwardNormal(slot, p);
        bool frontFace = dot(direction, outward) < 0.0;
        float3 normal = frontFace ? outward : -outward;

        float base = materialStart + slot * MATERIAL_VALUES;
        float kind = code(base);
        float3 color = vector(base + 1.0);
        float param = number(base + 4.0);

        if (kind == EMISSIVE) { return throughput * color; }

        float3 scattered;
        if (kind == METAL) {
            float3 reflected = reflect(normalize(direction), normalize(normal));
            scattered = reflected + randomInUnitSphere() * param;
            if (dot(scattered, normal) <= 0.0) { return float3(0.0); }
        } else if (kind == DIELECTRIC) {
            float ratio = frontFace ? 1.0 / param : param;
            float3 unitDirection = normalize(direction);
            float cosTheta = min(dot(-unitDirection, normal), 1.0);
            float sinTheta = sqrt(1.0 - cosTheta * cosTheta);
            bool shouldReflect = ratio * sinTheta > 1.0 || reflectance(cosTheta, ratio) > rnd();
            scattered = shouldReflect ? reflect(unitDirection, normal) : refractDir(unitDirection, normal, ratio);
        } else {
            scattered = normal + randomInUnitSphere();
            if (dot(scattered, scattered) < 1.0e-8) { scattered = normal; }
        }
        throughput *= color;
        origin = p;
        direction = scattered;
    }
    return float3(0.0);
}

half4 main(float2 position) {
    float i = floor(position.x);
    float j = frameSize.y - 1.0 - floor(position.y);
    pixelId = float2(i, j);
    counter = 0.0;

    float3 sum = float3(0.0);
    for (int n = 0; n < MAX_SAMPLES; n++) {
        if (float(n) >= samples) { break; }
        float s = (i + rnd()) / (frameSize.x - 1.0);
        float t = (j + rnd()) / (frameSize.y - 1.0);
        float2 rd = randomInUnitDisk() * lensRadius;
        float3 offset = camU * rd.x + camV * rd.y;
        float3 origin = camOrigin + offset;
        float3 direction = camLowerLeft + camHorizontal * s + camVertical * t - camOrigin - offset;
        sum += trace(origin, direction);
    }
    float taken = clamp(samples, 1.0, float(MAX_SAMPLES));
    float3 color = sqrt(clamp(sum / taken, 0.0, 1.0));
    return half4(half3(min(color, float3(0.999))), 1.0);
}
