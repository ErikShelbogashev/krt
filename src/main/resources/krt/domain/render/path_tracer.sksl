// GPU path tracer of krt (ADR 0009). Mirrors krt.domain.trace.PathTracing and the materials of the scene model.
// SkSL is GLSL ES 2.0: no recursion, loops have constant bounds and stop early with break, and local arrays take
// constant indices only, so the BVH is walked without a stack along skip links (see krt.domain.trace.FlatBvh).

uniform shader scene;               // RGBA_8888, one 24-bit number per texel, see GpuScene
uniform shader previous;            // the frame of the earlier steps, with previousSamples samples per pixel
uniform float previousSamples;
uniform float bandStart;            // the rows this step samples, from the top; the others keep the earlier frame
uniform float bandEnd;
uniform float nodeCount;
uniform float primitiveStart;
uniform float materialStart;
uniform float lightStart;           // the primitive slots of the lights, see GpuScene
uniform float lightCount;           // lights to sample (next event estimation, ADR 0012); 0 when it is off
uniform float memberStart;          // the members of the lights: primitive slots and cumulative areas
uniform float normalStart;          // the vertex normals of smooth triangles
uniform float smoothNormals;        // 1 when the scene has smooth triangles, so hits read their vertex normals
uniform float mediaStart;           // the media: density and albedo each (ADR 0014)
uniform float cameraMedium;         // the medium the camera stands in, -1 for clear air
uniform float quickLook;            // 1 for the quick look of a frame: no media and no light sampling (ADR 0010)
uniform float motionBlur;           // 1 when rays go at random moments of the shutter and balls move (ADR 0013)
uniform float3 skyHorizon;          // Sky: the gradient from the horizon to the zenith
uniform float3 skyZenith;
uniform float2 frameSize;
uniform float3 camOrigin;
uniform float3 camLowerLeft;
uniform float3 camHorizontal;
uniform float3 camVertical;
uniform float3 camU;
uniform float3 camV;
uniform float lensRadius;
uniform float maxDepth;
uniform float samples;
uniform float seed;

const int MAX_STEPS_PER_PATH = 48;  // bounces up to MAX_DEPTH and crossings of interfaces between media
const int MAX_SAMPLES = 64;
const int MAX_STEPS = 65536;        // nodes one ray may visit
const int LEAF_SIZE = 4;            // Bvh.LEAF_SIZE
const float TEXTURE_WIDTH = 1024.0;
const float RANGE = 4096.0;
const float NODE_VALUES = 9.0;
const float PRIMITIVE_VALUES = 14.0;
const float MEDIUM_VALUES = 6.0;
const float LIGHT_VALUES = 4.0;
const float MEMBER_VALUES = 2.0;
const float NORMAL_VALUES = 9.0;
const float MATERIAL_VALUES = 14.0;
const float T_MIN = 0.001;
const float FAR = 1.0e30;
const float PI = 3.14159265358979;

const float SPHERE = 0.0;
const float TRIANGLE = 1.0;
const float FRACTAL = 2.0;

const float LAMBERT = 0.0;
const float METAL = 1.0;
const float DIELECTRIC = 2.0;
const float EMISSIVE = 3.0;
const float PLASTIC = 4.0;
const float CHECKER = 5.0;
const float INTERFACE = 6.0;
const float BUBBLE = 7.0;
const float IRIDESCENT = 8.0;
const float CONDUCTOR = 9.0;
const float VELVET = 10.0;
const float PATTERNED = 11.0;
const float GLOWING = 12.0;

const float NOISE = 0.0;            // PatternKind
const float MARBLE = 1.0;
const float WOOD = 2.0;
const float CLOUDS = 3.0;
const float GRID = 4.0;
const float STRIPES = 5.0;

const float SPECULAR = 0.0;         // Lobe: how a ray left a surface, for light sampling
const float DIFFUSE = 1.0;
const float VOLUME = 2.0;
const float SHADOW_MARGIN = 1.0e-4;

// The 24-bit number at texel [index], as is: an index, a count or a code.
float code(float index) {
    float y = floor(index / TEXTURE_WIDTH);
    float x = index - y * TEXTURE_WIDTH;
    half4 c = scene.eval(float2(x + 0.5, y + 0.5));
    float r = floor(float(c.r) * 255.0 + 0.5);
    float g = floor(float(c.g) * 255.0 + 0.5);
    float b = floor(float(c.b) * 255.0 + 0.5);
    return r * 65536.0 + g * 256.0 + b;
}

// The fixed-point coordinate at texel [index].
float number(float index) {
    return code(index) / 16777216.0 * (2.0 * RANGE) - RANGE;
}

float3 vector(float index) {
    return float3(number(index), number(index + 1.0), number(index + 2.0));
}

// Hash without sine (Dave Hoskins): a pseudo-random number in [0, 1) from three floats.
float hash13(float3 p3) {
    p3 = fract(p3 * 0.1031);
    p3 += dot(p3, p3.zyx + 31.32);
    return fract((p3.x + p3.y) * p3.z);
}

float2 pixelId;
float counter;
float rayTime;                      // the moment of the shutter of the path being traced, as Ray.time

// Sphere.centerAt: the centre of the ball at [base] at the moment of the path; moving balls only with motion blur.
float3 centerOf(float base) {
    float3 center = vector(base + 1.0);
    if (motionBlur > 0.5) { center += vector(base + 5.0) * rayTime; }
    return center;
}

float rnd() {
    counter += 1.0;
    return hash13(float3(pixelId.x + seed * 17.0, pixelId.y + seed * 31.0, counter));
}

float3 randomInUnitSphere() {
    float z = 2.0 * rnd() - 1.0;
    float phi = 2.0 * PI * rnd();
    float r = sqrt(max(0.0, 1.0 - z * z));
    float scale = pow(rnd(), 1.0 / 3.0);
    return float3(r * cos(phi), r * sin(phi), z) * scale;
}

float2 randomInUnitDisk() {
    float phi = 2.0 * PI * rnd();
    return float2(cos(phi), sin(phi)) * sqrt(rnd());
}

float reflectance(float cosine, float refIdx) {
    float r0 = (1.0 - refIdx) / (1.0 + refIdx);
    r0 = r0 * r0;
    return r0 + (1.0 - r0) * pow(1.0 - cosine, 5.0);
}

float3 refractDir(float3 uv, float3 n, float etaiOverEtat) {
    float cosTheta = min(dot(-uv, n), 1.0);
    float3 rOutPerp = (uv + n * cosTheta) * etaiOverEtat;
    float3 rOutParallel = n * (-sqrt(abs(1.0 - dot(rOutPerp, rOutPerp))));
    return rOutPerp + rOutParallel;
}

// Spectrum.weight: the colour of light of one wavelength in nm, the weights of all wavelengths averaging to white.
float bump(float x, float peak, float width) {
    float u = (x - peak) / width;
    return exp(-u * u);
}

float3 spectrumWeight(float wavelength) {
    return float3(
        3.5733 * (bump(wavelength, 610.0, 50.0) + 0.15 * bump(wavelength, 425.0, 25.0)),
        4.2628 * bump(wavelength, 545.0, 45.0),
        5.4935 * bump(wavelength, 450.0, 35.0));
}

// ThinFilm.at: reflectance of a film between air and a substrate, unpolarised, by Airy's sum.
float airy(float r12, float r23, float phase) {
    float cross = 2.0 * r12 * r23 * cos(phase);
    return (r12 * r12 + r23 * r23 + cross) / (1.0 + r12 * r12 * r23 * r23 + cross);
}

float filmAt(float cosine, float thickness, float filmIor, float substrateIor, float wavelength) {
    float sinSquared = 1.0 - cosine * cosine;
    float inFilm = sqrt(max(0.0, 1.0 - sinSquared / (filmIor * filmIor)));
    float inSubstrate = sqrt(max(0.0, 1.0 - sinSquared / (substrateIor * substrateIor)));
    float phase = 4.0 * PI * filmIor * thickness * inFilm / wavelength;
    float s = airy((cosine - filmIor * inFilm) / (cosine + filmIor * inFilm),
        (filmIor * inFilm - substrateIor * inSubstrate) / (filmIor * inFilm + substrateIor * inSubstrate), phase);
    float p = airy((inFilm - filmIor * cosine) / (inFilm + filmIor * cosine),
        (filmIor * inSubstrate - substrateIor * inFilm) / (filmIor * inSubstrate + substrateIor * inFilm), phase);
    return 0.5 * (s + p);
}

// ThinFilm.reflectance: at the wavelength the ray carries, or at those of the red, green and blue channels.
float3 filmReflectance(float cosine, float thickness, float filmIor, float substrateIor, float wavelength) {
    if (wavelength > 0.0) { return float3(filmAt(cosine, thickness, filmIor, substrateIor, wavelength)); }
    return float3(filmAt(cosine, thickness, filmIor, substrateIor, 650.0),
        filmAt(cosine, thickness, filmIor, substrateIor, 532.0),
        filmAt(cosine, thickness, filmIor, substrateIor, 450.0));
}

float filmChance(float3 reflectance) {
    return clamp((reflectance.x + reflectance.y + reflectance.z) / 3.0, 0.02, 0.98);
}

float3 sky(float3 direction) {
    float t = 0.5 * (normalize(direction).y + 1.0);
    return skyHorizon * (1.0 - t) + skyZenith * t;
}

// Möller–Trumbore, as Triangle.hit: the triangle at [base] is its first vertex and the edges from it.
float intersectTriangle(float base, float3 origin, float3 direction, float tMax) {
    float3 v0 = vector(base + 1.0);
    float3 edge1 = vector(base + 4.0);
    float3 edge2 = vector(base + 7.0);
    float3 h = cross(direction, edge2);
    float a = dot(edge1, h);
    if (abs(a) < 1.0e-10) { return -1.0; }
    float f = 1.0 / a;
    float3 s = origin - v0;
    float u = f * dot(s, h);
    if (u < 0.0 || u > 1.0) { return -1.0; }
    float3 q = cross(s, edge1);
    float v = f * dot(direction, q);
    if (v < 0.0 || u + v > 1.0) { return -1.0; }
    float t = f * dot(edge2, q);
    if (t < T_MIN || t > tMax) { return -1.0; }
    return t;
}

// FractalDistance: the distance estimates of the fractals in their own space, as the Kotlin functions.
float mandelbulb(float3 p, float iterations, float power) {
    float3 z = p;
    float dr = 1.0;
    float r = length(z);
    for (int i = 0; i < 16; i++) {
        if (float(i) >= iterations || r > 2.0) { break; }
        float theta = acos(clamp(z.z / r, -1.0, 1.0)) * power;
        float phi = atan(z.y, z.x) * power;
        dr = power * pow(r, power - 1.0) * dr + 1.0;
        float zr = pow(r, power);
        z = zr * float3(sin(theta) * cos(phi), sin(theta) * sin(phi), cos(theta)) + p;
        r = length(z);
    }
    return 0.5 * log(r) * r / dr;
}

float boxDistance(float3 p) {
    float3 q = abs(p) - float3(1.0);
    return length(max(q, float3(0.0))) + min(max(q.x, max(q.y, q.z)), 0.0);
}

float menger(float3 p, float iterations) {
    float d = boxDistance(p);
    float s = 1.0;
    for (int i = 0; i < 8; i++) {
        if (float(i) >= iterations) { break; }
        float3 a = mod(p * s, 2.0) - 1.0;
        s *= 3.0;
        float3 r = abs(1.0 - 3.0 * abs(a));
        float c = (min(max(r.x, r.y), min(max(r.y, r.z), max(r.z, r.x))) - 1.0) / s;
        d = max(d, c);
    }
    return d;
}

float mandelbox(float3 p, float iterations, float scale) {
    float3 z = p;
    float dr = 1.0;
    for (int i = 0; i < 16; i++) {
        if (float(i) >= iterations) { break; }
        z = clamp(z, -1.0, 1.0) * 2.0 - z;
        float r2 = dot(z, z);
        float factor = r2 < 0.25 ? 4.0 : (r2 < 1.0 ? 1.0 / r2 : 1.0);
        z = z * factor * scale + p;
        dr = dr * factor * abs(scale) + 1.0;
    }
    return length(z) / abs(dr);
}

float julia(float3 p, float iterations, float3 c) {
    float4 q = float4(p, 0.0);
    float md2 = 1.0;
    float mz2 = dot(p, p);
    for (int i = 0; i < 16; i++) {
        if (float(i) >= iterations || mz2 > 4.0) { break; }
        md2 *= 4.0 * mz2;
        q = float4(q.x * q.x - q.y * q.y - q.z * q.z - q.w * q.w, 2.0 * q.x * q.yzw) + float4(c, 0.0);
        mz2 = dot(q, q);
    }
    return 0.25 * sqrt(mz2 / md2) * log(mz2);
}

// Fractal.distance: from [p] in the world to the surface of the fractal at [base], at most.
float fractalDistance(float base, float3 p) {
    float radius = number(base + 4.0);
    float kind = code(base + 5.0);
    float nativeRadius = kind == 0.0 ? 1.25 : (kind == 1.0 ? 1.75 : (kind == 2.0 ? 10.4 : 1.5));
    float scale = radius / nativeRadius;
    float3 q = (p - vector(base + 1.0)) / scale;
    float iterations = code(base + 6.0);
    float parameter = number(base + 7.0);
    float d;
    if (kind == 0.0) { d = mandelbulb(q, iterations, parameter); }
    else if (kind == 1.0) { d = menger(q, iterations); }
    else if (kind == 2.0) { d = mandelbox(q, iterations, parameter); }
    else { d = julia(q, iterations, vector(base + 8.0)); }
    return d * scale;
}

// Fractal.hit: sphere tracing inside the bounding ball, until closer than a ten-thousandth of the radius.
float intersectFractal(float base, float3 origin, float3 direction, float tMax) {
    float3 oc = origin - vector(base + 1.0);
    float radius = number(base + 4.0);
    float a = dot(direction, direction);
    float halfB = dot(oc, direction);
    float discriminant = halfB * halfB - a * (dot(oc, oc) - radius * radius);
    if (discriminant < 0.0) { return -1.0; }
    float root = sqrt(discriminant);
    float speed = sqrt(a);
    float t = max((-halfB - root) / a, T_MIN);
    float leave = min((-halfB + root) / a, tMax);
    float epsilon = radius * 1.0e-4;
    for (int i = 0; i < 160; i++) {
        if (t >= leave) { return -1.0; }
        float d = fractalDistance(base, origin + direction * t);
        if (d < epsilon) { return t; }
        t += d / speed;
    }
    return -1.0;
}

// Fractal.normalAt: the gradient of the distance by four taps on a tetrahedron.
float3 fractalNormal(float base, float3 p) {
    float h = number(base + 4.0) * 2.0e-4;
    float3 a = float3(1.0, -1.0, -1.0);
    float3 b = float3(-1.0, -1.0, 1.0);
    float3 c = float3(-1.0, 1.0, -1.0);
    float3 d = float3(1.0, 1.0, 1.0);
    return normalize(a * fractalDistance(base, p + a * h) + b * fractalDistance(base, p + b * h) +
        c * fractalDistance(base, p + c * h) + d * fractalDistance(base, p + d * h));
}

// Distance along the ray to primitive [slot] within [T_MIN, tMax], or -1 when the ray misses it.
float intersect(float slot, float3 origin, float3 direction, float tMax) {
    float base = primitiveStart + slot * PRIMITIVE_VALUES;
    float kind = code(base);
    if (kind == TRIANGLE) { return intersectTriangle(base, origin, direction, tMax); }
    if (kind == FRACTAL) { return intersectFractal(base, origin, direction, tMax); }
    float3 center = centerOf(base);
    float radius = number(base + 4.0);
    float3 oc = origin - center;
    float a = dot(direction, direction);
    float halfB = dot(oc, direction);
    float c = dot(oc, oc) - radius * radius;
    float discriminant = halfB * halfB - a * c;
    if (discriminant < 0.0) { return -1.0; }
    float sqrtD = sqrt(discriminant);
    float root = (-halfB - sqrtD) / a;
    if (root < T_MIN || root > tMax) { root = (-halfB + sqrtD) / a; }
    if (root < T_MIN || root > tMax) { return -1.0; }
    return root;
}

// Normal of primitive [slot] at [p], pointing out of it.
float3 outwardNormal(float slot, float3 p) {
    float base = primitiveStart + slot * PRIMITIVE_VALUES;
    float kind = code(base);
    if (kind == TRIANGLE) { return normalize(cross(vector(base + 4.0), vector(base + 7.0))); }
    if (kind == FRACTAL) { return fractalNormal(base, p); }
    return (p - centerOf(base)) / number(base + 4.0);
}

// The normal to shade with at [p] on primitive [slot], whose flat normal is [outward]: blended from the vertex
// normals of a smooth triangle, as VertexNormals.at, or [outward] itself.
float3 shadingNormal(float slot, float3 p, float3 outward) {
    if (smoothNormals < 0.5) { return outward; }
    float base = primitiveStart + slot * PRIMITIVE_VALUES;
    float record = code(base + 11.0);
    if (record < 1.0) { return outward; }
    float3 edge1 = vector(base + 4.0);
    float3 edge2 = vector(base + 7.0);
    float3 w = p - vector(base + 1.0);
    float d00 = dot(edge1, edge1);
    float d01 = dot(edge1, edge2);
    float d11 = dot(edge2, edge2);
    float d20 = dot(w, edge1);
    float d21 = dot(w, edge2);
    float denominator = d00 * d11 - d01 * d01;
    float u = (d11 * d20 - d01 * d21) / denominator;
    float v = (d00 * d21 - d01 * d20) / denominator;
    float at = normalStart + (record - 1.0) * NORMAL_VALUES;
    float3 blended = normalize(vector(at) * (1.0 - u - v) + vector(at + 3.0) * u + vector(at + 6.0) * v);
    return dot(blended, outward) < 0.0 ? -blended : blended;
}

// Microfacets.frame: the tangent around the vertical axis; the bitangent is cross(normal, tangent).
float3 tangentOf(float3 normal) {
    float3 axis = abs(normal.y) < 0.999 ? float3(0.0, 1.0, 0.0) : float3(1.0, 0.0, 0.0);
    return normalize(cross(axis, normal));
}

// Microfacets.frame with a direction of brushing laid on the surface; around the vertical axis without one.
float3 tangentAlong(float3 normal, float3 direction) {
    float3 along = direction - normal * dot(direction, normal);
    return length(along) < 1.0e-6 ? tangentOf(normal) : normalize(along);
}

// Microfacets.visibleNormal: Heitz's sampling of the GGX normals the direction [o] sees, in the local frame.
float3 visibleNormal(float3 o, float alphaX, float alphaY) {
    float3 stretched = normalize(float3(alphaX * o.x, alphaY * o.y, o.z));
    float lengthSquared = stretched.x * stretched.x + stretched.y * stretched.y;
    float3 t1 = lengthSquared > 0.0 ? float3(-stretched.y, stretched.x, 0.0) / sqrt(lengthSquared)
        : float3(1.0, 0.0, 0.0);
    float3 t2 = cross(stretched, t1);
    float radius = sqrt(rnd());
    float phi = 2.0 * PI * rnd();
    float p1 = radius * cos(phi);
    float blend = (1.0 + stretched.z) * 0.5;
    float p2 = (1.0 - blend) * sqrt(1.0 - p1 * p1) + blend * radius * sin(phi);
    float3 h = t1 * p1 + t2 * p2 + stretched * sqrt(max(0.0, 1.0 - p1 * p1 - p2 * p2));
    return normalize(float3(alphaX * h.x, alphaY * h.y, max(0.0, h.z)));
}

// Microfacets.lambda: Smith's Λ of a local direction.
float ggxLambda(float3 w, float alphaX, float alphaY) {
    float cosSquared = w.z * w.z;
    float slopes = (alphaX * alphaX * w.x * w.x + alphaY * alphaY * w.y * w.y) / max(cosSquared, 1.0e-12);
    return (sqrt(1.0 + slopes) - 1.0) * 0.5;
}

// Microfacets.shadowing: G2 / G1.
float shadowing(float3 o, float3 i, float alphaX, float alphaY) {
    float viewer = ggxLambda(float3(o.xy, abs(o.z)), alphaX, alphaY);
    return (1.0 + viewer) / (1.0 + viewer + ggxLambda(float3(i.xy, abs(i.z)), alphaX, alphaY));
}

// ConductorFresnel.reflectance: exact unpolarised Fresnel of a metal of complex index eta + i k, per channel.
float3 conductorFresnel(float cosine, float3 eta, float3 k) {
    float cos2 = cosine * cosine;
    float sin2 = 1.0 - cos2;
    float3 t0 = eta * eta - k * k - sin2;
    float3 a2b2 = sqrt(t0 * t0 + 4.0 * eta * eta * k * k);
    float3 a = sqrt(max(float3(0.0), (a2b2 + t0) * 0.5));
    float3 t1 = a2b2 + cos2;
    float3 t2 = 2.0 * a * cosine;
    float3 rs = (t1 - t2) / (t1 + t2);
    float3 t3 = cos2 * a2b2 + sin2 * sin2;
    float3 t4 = t2 * sin2;
    float3 rp = rs * (t3 - t4) / (t3 + t4);
    return (rs + rp) * 0.5;
}

// Sheen.weight: the Charlie sheen BRDF with Neubelt's visibility, times the cosine over the pdf of Lambert's sampling.
float sheenWeight(float3 toViewer, float3 toLight, float3 normal, float roughness) {
    float cosViewer = max(dot(toViewer, normal), 0.0);
    float cosLight = max(dot(toLight, normal), 0.0);
    float cosHalf = dot(normalize(toViewer + toLight), normal);
    float inverseAlpha = 1.0 / max(roughness * roughness, 1.0e-3);
    float distribution = (2.0 + inverseAlpha) * pow(max(1.0 - cosHalf * cosHalf, 0.0), inverseAlpha * 0.5) / (2.0 * PI);
    float visibility = 1.0 / max(4.0 * (cosLight + cosViewer - cosLight * cosViewer), 1.0e-3);
    return distribution * visibility * PI;
}

// Noise: Perlin's improved noise over the lattice hash (34x² + x) mod 289, exact in floats, so it matches the CPU.
float permute(float x) { return mod((34.0 * x + 1.0) * x, 289.0); }

float fade(float t) { return t * t * t * (t * (t * 6.0 - 15.0) + 10.0); }

float gradient(float hash, float3 d) {
    float h = mod(hash, 16.0);
    float u = h < 8.0 ? d.x : d.y;
    float v = h < 4.0 ? d.y : (h == 12.0 || h == 14.0 ? d.x : d.z);
    return (mod(h, 2.0) == 0.0 ? u : -u) + (mod(floor(h * 0.5), 2.0) == 0.0 ? v : -v);
}

float corner(float3 i, float3 f, float3 d) {
    return gradient(permute(permute(permute(i.x + d.x) + i.y + d.y) + i.z + d.z), f - d);
}

float perlin(float3 p) {
    float3 cell = floor(p);
    float3 f = p - cell;
    float3 i = mod(cell, 289.0);
    float3 u = float3(fade(f.x), fade(f.y), fade(f.z));
    float x00 = mix(corner(i, f, float3(0.0, 0.0, 0.0)), corner(i, f, float3(1.0, 0.0, 0.0)), u.x);
    float x10 = mix(corner(i, f, float3(0.0, 1.0, 0.0)), corner(i, f, float3(1.0, 1.0, 0.0)), u.x);
    float x01 = mix(corner(i, f, float3(0.0, 0.0, 1.0)), corner(i, f, float3(1.0, 0.0, 1.0)), u.x);
    float x11 = mix(corner(i, f, float3(0.0, 1.0, 1.0)), corner(i, f, float3(1.0, 1.0, 1.0)), u.x);
    return mix(mix(x00, x10, u.y), mix(x01, x11, u.y), u.z);
}

// Noise.fbm, or Noise.turbulence with [absolute], of [octaves] octaves.
float fractal(float3 p, bool absolute, float octaves) {
    float sum = 0.0;
    float amplitude = 1.0;
    for (int octave = 0; octave < 8; octave++) {
        if (float(octave) >= octaves) { break; }
        float n = perlin(p);
        sum += amplitude * (absolute ? abs(n) : n);
        amplitude *= 0.5;
        p *= 2.0;
    }
    return sum;
}

// Pattern.valueAt: the blend of the two colours at [p], in [0, 1].
float patternValue(float kind, float3 p, float scale, float turbulence, float frequency, float octaves) {
    float3 q = p * scale;
    float value;
    if (kind == MARBLE) {
        float veins = q.x * 2.0 * PI * frequency + turbulence * 4.0 * fractal(q, true, octaves);
        value = 1.0 - sqrt(0.5 + 0.5 * sin(veins));
    } else if (kind == WOOD) {
        // The trunk along x: long stripes of thin dark latewood, wavy along the grain, over fine fibres.
        float rings = sqrt(q.y * q.y + q.z * q.z) * frequency + turbulence * perlin(q * float3(0.25, 2.0, 2.0));
        float ring = rings - floor(rings);
        float latewood = smoothstep(0.72, 0.9, ring) * (1.0 - smoothstep(0.9, 1.0, ring));
        float fibres = 0.5 + 0.5 * perlin(q * float3(0.5, 24.0, 24.0));
        value = 0.75 * latewood + 0.25 * fibres;
    } else if (kind == CLOUDS) {
        value = smoothstep(0.45, 0.75, 0.5 + 0.5 * fractal(q, false, octaves));
    } else if (kind == GRID) {
        float3 cell = q - floor(q);
        value = (cell.x < frequency || cell.y < frequency || cell.z < frequency) ? 1.0 : 0.0;
    } else if (kind == STRIPES) {
        value = smoothstep(0.35, 0.65, 0.5 + 0.5 * sin(2.0 * PI * frequency * q.y));
    } else {
        value = 0.5 + 0.5 * fractal(q, false, octaves);
    }
    return clamp(value, 0.0, 1.0);
}

// The pattern of the material at [base]: its blend at [p].
float materialPattern(float base, float3 p) {
    return patternValue(number(base + 10.0), p, number(base + 5.0), number(base + 11.0), number(base + 12.0),
        number(base + 13.0));
}

// Bump.normal: [normal] tilted against the slope of the pattern times [strength].
float3 bumpNormal(float base, float3 p, float3 normal, float strength) {
    float scale = number(base + 5.0);
    float step = 1.0e-3 / scale;
    float here = materialPattern(base, p);
    float3 slope = float3(materialPattern(base, p + float3(step, 0.0, 0.0)) - here,
        materialPattern(base, p + float3(0.0, step, 0.0)) - here,
        materialPattern(base, p + float3(0.0, 0.0, step)) - here) / step;
    float3 along = slope - normal * dot(slope, normal);
    return normalize(normal - along * (strength / scale));
}

// Light given off at [p] by the material at [base] of [kind]: its colour, or a glowing pattern's at the point.
float3 emission(float base, float kind, float3 p) {
    float3 color = vector(base + 1.0);
    if (kind != GLOWING) { return color; }
    return mix(color, vector(base + 6.0), materialPattern(base, p)) * number(base + 4.0);
}

float hitT;

// The primitive the ray hits first before tMax, or -1; its distance goes to hitT. Walks the BVH along skip links.
float closestHit(float3 origin, float3 direction, float tMax) {
    hitT = tMax;
    float hitSlot = -1.0;
    float3 inverse = 1.0 / direction;
    float node = 0.0;
    for (int step = 0; step < MAX_STEPS; step++) {
        if (node >= nodeCount) { break; }
        float base = node * NODE_VALUES;
        float3 t1 = (vector(base) - origin) * inverse;
        float3 t2 = (vector(base + 3.0) - origin) * inverse;
        float3 lo = min(t1, t2);
        float3 hi = max(t1, t2);
        float near = max(max(lo.x, lo.y), max(lo.z, T_MIN));
        float far = min(min(hi.x, hi.y), min(hi.z, hitT));
        if (far < near) {
            node = code(base + 6.0);
        } else {
            float count = code(base + 8.0);
            float first = code(base + 7.0);
            for (int k = 0; k < LEAF_SIZE; k++) {
                if (float(k) >= count) { break; }
                float t = intersect(first + float(k), origin, direction, hitT);
                if (t > 0.0) {
                    hitT = t;
                    hitSlot = first + float(k);
                }
            }
            node += 1.0;
        }
    }
    return hitSlot;
}

float3 mediumDensity(float medium) { return vector(mediaStart + medium * MEDIUM_VALUES); }

float3 mediumAlbedo(float medium) { return vector(mediaStart + medium * MEDIUM_VALUES + 3.0); }

// The medium beyond the surface of primitive [slot] for a ray that passes it [frontFace] first, as PathTracing.after:
// 1 + its number in the primitive's record, the inside one through the front, the outside one through the back.
float mediumBeyond(float slot, bool frontFace) {
    float base = primitiveStart + slot * PRIMITIVE_VALUES;
    return code(base + (frontFace ? 12.0 : 13.0)) - 1.0;
}

bool boundsMedia(float slot) {
    float base = primitiveStart + slot * PRIMITIVE_VALUES;
    return code(base + 12.0) + code(base + 13.0) > 0.0;
}

// FreeFlight.distance: the distance to the next particle, with the density of one channel picked at random.
float freeDistance(float3 density) {
    float pick = rnd();
    float channel = pick < 1.0 / 3.0 ? density.x : (pick < 2.0 / 3.0 ? density.y : density.z);
    float u = rnd();
    return channel > 0.0 ? -log(1.0 - u) / channel : FAR;
}

// PathTracing.transmittance: the share of light along a unit [direction] over [distance] from [origin] in [medium]:
// none past a solid surface; through media and their interfaces, what the media let through.
float3 transmittance(float3 origin, float3 direction, float distance, float medium) {
    float3 share = float3(1.0);
    float remaining = distance;
    for (int crossing = 0; crossing < 8; crossing++) {
        float slot = closestHit(origin, direction, remaining);
        if (slot < 0.0) {
            return medium >= 0.0 ? share * exp(-mediumDensity(medium) * remaining) : share;
        }
        if (code(materialStart + slot * MATERIAL_VALUES) != INTERFACE) { return float3(0.0); }
        if (medium >= 0.0) { share *= exp(-mediumDensity(medium) * hitT); }
        float3 p = origin + direction * hitT;
        medium = mediumBeyond(slot, dot(direction, outwardNormal(slot, p)) < 0.0);
        remaining -= hitT;
        origin = p;
    }
    return float3(0.0);
}

// Light reaching [p] straight from one light picked at random, as Lights.sample and PathTracing.direct take it:
// a uniform point on the light, shadowed or not, weighed by the response of the lobe and the pdf of the sample.
float3 directLight(float3 p, float3 normal, float lobe, float medium) {
    // Lights.sample: a light by its share of the weights, a member by its share of the light's area, both by binary
    // search over whole numbers of 2^24.
    float target = rnd() * 16777215.0;
    float low = 0.0;
    float high = lightCount - 1.0;
    for (int i = 0; i < 16; i++) {
        if (low >= high) { break; }
        float middle = floor((low + high) * 0.5);
        if (code(lightStart + middle * LIGHT_VALUES) > target) { high = middle; } else { low = middle + 1.0; }
    }
    float record = lightStart + low * LIGHT_VALUES;
    float first = code(record + 1.0);
    float chance = exp2(code(record + 3.0) / 131072.0 - 64.0);
    target = rnd() * 16777215.0;
    low = first;
    high = first + code(record + 2.0) - 1.0;
    for (int i = 0; i < 16; i++) {
        if (low >= high) { break; }
        float middle = floor((low + high) * 0.5);
        if (code(memberStart + middle * MEMBER_VALUES + 1.0) > target) { high = middle; } else { low = middle + 1.0; }
    }
    float slot = code(memberStart + low * MEMBER_VALUES);
    float base = primitiveStart + slot * PRIMITIVE_VALUES;
    float3 point;
    float3 lightNormal;
    bool twoSided = code(base) == TRIANGLE;
    if (twoSided) {
        float3 edge1 = vector(base + 4.0);
        float3 edge2 = vector(base + 7.0);
        float u = rnd();
        float v = rnd();
        if (u + v > 1.0) { u = 1.0 - u; v = 1.0 - v; }
        float3 c = cross(edge1, edge2);
        float doubleArea = length(c);
        point = vector(base + 1.0) + edge1 * u + edge2 * v;
        lightNormal = c / doubleArea;
    } else {
        float radius = number(base + 4.0);
        float z = 1.0 - 2.0 * rnd();
        float phi = 2.0 * PI * rnd();
        float ring = sqrt(max(0.0, 1.0 - z * z));
        lightNormal = float3(ring * cos(phi), ring * sin(phi), z);
        point = centerOf(base) + lightNormal * radius;
    }
    float3 toLight = point - p;
    float distanceSquared = dot(toLight, toLight);
    float distance = sqrt(distanceSquared);
    float3 direction = toLight / distance;
    float facing = -dot(direction, lightNormal);
    float cosine = twoSided ? abs(facing) : facing;
    if (cosine <= 1.0e-6) { return float3(0.0); }
    float pdf = distanceSquared / cosine * chance;
    // PathTracing.diffuse: diffuse bounces go to a random point in the unit ball at the tip of the normal, 2 cos³ / π.
    float lit = max(0.0, dot(normal, direction));
    float response = lobe == VOLUME ? 1.0 / (4.0 * PI) : 2.0 * lit * lit * lit / PI;
    if (response == 0.0) { return float3(0.0); }
    float lightBase = materialStart + slot * MATERIAL_VALUES;
    float3 light = emission(lightBase, code(lightBase), point);
    return light * transmittance(p, direction, distance * (1.0 - SHADOW_MARGIN), medium) * (response / pdf);
}

float3 trace(float3 origin, float3 direction) {
    rayTime = motionBlur > 0.5 ? rnd() : 0.0;
    float3 radiance = float3(0.0);
    float3 throughput = float3(1.0);
    bool countEmission = true;
    float wavelength = 0.0;         // 0 for white light, the wavelength in nm once dispersion split it
    float medium = quickLook > 0.5 ? -1.0 : cameraMedium; // the medium of the path, -1 for clear air (ADR 0014)
    bool enclosed = false;          // whether a solid surface closes that medium, so its particles sample no lights
    float bounces = 0.0;            // crossings of interfaces between media do not count
    for (int step = 0; step < MAX_STEPS_PER_PATH; step++) {
        if (bounces >= maxDepth) { break; }

        float slot = closestHit(origin, direction, FAR);
        if (medium >= 0.0) {
            // PathTracing.color in a medium: a particle before the surface, or the surface, weighed by FreeFlight.
            float3 density = mediumDensity(medium);
            float speed = length(direction);
            float flight = freeDistance(density);
            float surfaceDistance = slot < 0.0 ? FAR : hitT * speed;
            if (flight < surfaceDistance) {
                float3 passed = exp(-density * flight);
                float pdf = dot(density * passed, float3(1.0 / 3.0));
                if (pdf <= 0.0) { return radiance; }
                throughput *= mediumAlbedo(medium) * density * passed / pdf;
                float3 at = origin + direction * (flight / speed);
                float particleLobe = enclosed ? SPECULAR : VOLUME;
                countEmission = lightCount < 1.0 || particleLobe == SPECULAR;
                if (!countEmission) { radiance += throughput * directLight(at, float3(0.0), VOLUME, medium); }
                origin = at;
                direction = normalize(randomInUnitSphere());
                bounces += 1.0;
                continue;
            }
            if (slot < 0.0) { return radiance; }
            float3 through = exp(-density * surfaceDistance);
            float chance = dot(through, float3(1.0 / 3.0));
            if (chance <= 0.0) { return radiance; }
            throughput *= through / chance;
        }
        if (slot < 0.0) { return radiance + throughput * sky(direction); }

        float3 p = origin + direction * hitT;
        float3 outward = outwardNormal(slot, p);
        bool frontFace = dot(direction, outward) < 0.0;
        float3 shading = shadingNormal(slot, p, outward);
        float3 normal = frontFace ? shading : -shading;

        float base = materialStart + slot * MATERIAL_VALUES;
        float kind = code(base);
        float3 color = vector(base + 1.0);
        float param = number(base + 4.0);

        if (kind == EMISSIVE || kind == GLOWING) {
            // A glowing fractal is no sampled light (Emitters): its glow counts on every bounce.
            bool unsampled = code(primitiveStart + slot * PRIMITIVE_VALUES) == FRACTAL;
            return countEmission || unsampled ? radiance + throughput * emission(base, kind, p) : radiance;
        }

        float3 scattered;
        float3 attenuation = color;
        float lobe = SPECULAR;
        if (kind == PATTERNED) {
            // A pattern under a clear coat, as Patterned: the colour, and the bump of the normal.
            float t = materialPattern(base, p);
            color = mix(color, vector(base + 6.0), t);
            attenuation = color;
            float bump = number(base + 9.0);
            if (bump > 0.0) { normal = bumpNormal(base, p, normal, bump); }
        }
        if (kind == PLASTIC || kind == CHECKER || kind == PATTERNED) {
            // Clear coat over a diffuse base, as ClearCoat.scatter.
            float3 unitDirection = normalize(direction);
            float cosine = min(dot(-unitDirection, normal), 1.0);
            float coatIor = kind == PATTERNED ? 1.5 : number(base + 5.0);
            if (rnd() < reflectance(cosine, coatIor)) {
                scattered = reflect(unitDirection, normal) + randomInUnitSphere() * param;
                if (dot(scattered, normal) <= 0.0) { return radiance; }
                attenuation = float3(1.0);
            } else {
                scattered = normal + randomInUnitSphere();
                if (dot(scattered, scattered) < 1.0e-8) { scattered = normal; }
                lobe = DIFFUSE;
                if (kind == CHECKER) {
                    float cell = number(base + 9.0);
                    float cells = floor(p.x / cell) + floor(p.y / cell) + floor(p.z / cell);
                    attenuation = mod(cells, 2.0) == 0.0 ? color : vector(base + 6.0);
                }
            }
        } else if (kind == METAL) {
            float3 reflected = reflect(normalize(direction), normalize(normal));
            scattered = reflected + randomInUnitSphere() * param;
            if (dot(scattered, normal) <= 0.0) { return radiance; }
        } else if (kind == DIELECTRIC) {
            // Beer–Lambert: light inside tinted glass fades with the distance it travelled.
            attenuation = frontFace ? float3(1.0) : exp(-color * hitT * length(direction));
            // Dispersion, as Dielectric.indexAt: white light goes on as light of one random wavelength.
            float dispersion = number(base + 5.0);
            float index = param;
            if (dispersion != 0.0) {
                if (wavelength == 0.0) {
                    wavelength = 380.0 + 340.0 * rnd();
                    attenuation *= spectrumWeight(wavelength);
                }
                float micrometres = wavelength / 1000.0;
                index = param + dispersion * (1.0 / (micrometres * micrometres) - 1.0 / (0.5876 * 0.5876));
            }
            float ratio = frontFace ? 1.0 / index : index;
            float3 unitDirection = normalize(direction);
            // Frosted glass, as Dielectric with roughness: the light meets a GGX microfacet, not the surface.
            float alpha = number(base + 9.0);
            float3 tangent = float3(0.0);
            float3 bitangent = float3(0.0);
            float3 o = float3(0.0);
            float3 facet = normal;
            if (alpha > 0.0) {
                tangent = tangentOf(normal);
                bitangent = cross(normal, tangent);
                o = float3(dot(-unitDirection, tangent), dot(-unitDirection, bitangent), dot(-unitDirection, normal));
                float3 m = visibleNormal(o, alpha, alpha);
                facet = tangent * m.x + bitangent * m.y + normal * m.z;
            }
            float cosTheta = min(dot(-unitDirection, facet), 1.0);
            float sinTheta = sqrt(1.0 - cosTheta * cosTheta);
            bool shouldReflect = ratio * sinTheta > 1.0 || reflectance(cosTheta, ratio) > rnd();
            scattered = shouldReflect ? reflect(unitDirection, facet) : refractDir(unitDirection, facet, ratio);
            if (alpha > 0.0) {
                float3 i = float3(dot(scattered, tangent), dot(scattered, bitangent), dot(scattered, normal));
                if (shouldReflect ? i.z <= 0.0 : i.z >= 0.0) { return radiance; }
                attenuation *= shadowing(o, i, alpha, alpha);
            }
        } else if (kind == VELVET) {
            // Velvet: the diffuse bounce, lit by light sampling, or the sheen one, as Velvet.scatter.
            float diffuseChance = number(base + 5.0);
            bool diffuse = rnd() < diffuseChance;
            float3 offset = randomInUnitSphere();
            scattered = normal + (diffuse ? offset : normalize(offset));
            if (dot(scattered, scattered) < 1.0e-8) { scattered = normal; }
            if (diffuse) {
                attenuation = color / diffuseChance;
                lobe = DIFFUSE;
            } else {
                float weight = sheenWeight(-normalize(direction), normalize(scattered), normal, param);
                attenuation = vector(base + 6.0) * (weight / (1.0 - diffuseChance));
            }
        } else if (kind == CONDUCTOR) {
            // Metal with GGX microfacets, as Conductor.scatter, brushed along the direction it gives, if any.
            float3 tangent = tangentAlong(normal, vector(base + 9.0));
            float3 bitangent = cross(normal, tangent);
            float3 toViewer = -normalize(direction);
            float3 o = float3(dot(toViewer, tangent), dot(toViewer, bitangent), dot(toViewer, normal));
            float alphaY = number(base + 5.0);
            float3 m = visibleNormal(o, param, alphaY);
            float3 i = m * (2.0 * dot(o, m)) - o;
            if (o.z <= 0.0 || i.z <= 0.0) { return radiance; }
            attenuation = conductorFresnel(dot(o, m), color, vector(base + 6.0)) * shadowing(o, i, param, alphaY);
            scattered = tangent * i.x + bitangent * i.y + normal * i.z;
        } else if (kind == BUBBLE || kind == IRIDESCENT) {
            // Thin film, as SoapBubble and Iridescent: interference colours the reflection.
            float3 unitDirection = normalize(direction);
            float cosine = min(dot(-unitDirection, normal), 1.0);
            float3 reflectance = filmReflectance(cosine, param, number(base + 5.0), kind == BUBBLE ? 1.0 : 1.5,
                wavelength);
            float chance = filmChance(reflectance);
            if (rnd() < chance) {
                scattered = reflect(unitDirection, normal);
                if (kind == IRIDESCENT) { scattered += randomInUnitSphere() * number(base + 9.0); }
                if (dot(scattered, normal) <= 0.0) { return radiance; }
                attenuation = reflectance / chance;
            } else if (kind == BUBBLE) {
                scattered = unitDirection;
                attenuation = (float3(1.0) - reflectance) / (1.0 - chance);
            } else {
                scattered = normal + randomInUnitSphere();
                if (dot(scattered, scattered) < 1.0e-8) { scattered = normal; }
                attenuation = color * (float3(1.0) - reflectance) / (1.0 - chance);
                lobe = DIFFUSE;
            }
        } else if (kind == INTERFACE) {
            // The edge of a medium: light passes unchanged and only the medium changes; no bounce, no new lobe.
            medium = quickLook > 0.5 ? -1.0 : mediumBeyond(slot, frontFace);
            enclosed = false;
            origin = p;
            continue;
        } else {
            scattered = normal + randomInUnitSphere();
            if (dot(scattered, scattered) < 1.0e-8) { scattered = normal; }
            lobe = DIFFUSE;
        }
        throughput *= attenuation;
        countEmission = lightCount < 1.0 || lobe == SPECULAR;
        if (!countEmission) { radiance += throughput * directLight(p, normal, lobe, medium); }
        if (quickLook < 0.5 && boundsMedia(slot) && dot(scattered, normal) < 0.0) {
            // Through a surface that bounds media, as PathTracing.after: into the medium beyond, closed by it.
            medium = mediumBeyond(slot, frontFace);
            enclosed = frontFace;
        }
        origin = p;
        direction = scattered;
        bounces += 1.0;
    }
    return radiance;
}

// A sample gone NaN or infinite, from a zero density deep in a medium, is dropped: on some GPUs it would come out
// of the clamps below as any colour at all, a magenta band.
float3 finiteOrBlack(float3 c) {
    bool finite = all(equal(c, c)) && max(c.r, max(c.g, c.b)) < 1e30 && min(c.r, min(c.g, c.b)) > -1e30;
    return finite ? c : float3(0.0);
}

half4 main(float2 position) {
    if (position.y < bandStart || position.y >= bandEnd) { return previous.eval(position); }
    float i = floor(position.x);
    float j = frameSize.y - 1.0 - floor(position.y);
    pixelId = float2(i, j);
    counter = 0.0;

    float3 sum = float3(0.0);
    for (int n = 0; n < MAX_SAMPLES; n++) {
        if (float(n) >= samples) { break; }
        float s = (i + rnd()) / (frameSize.x - 1.0);
        float t = (j + rnd()) / (frameSize.y - 1.0);
        float2 rd = randomInUnitDisk() * lensRadius;
        float3 offset = camU * rd.x + camV * rd.y;
        float3 origin = camOrigin + offset;
        float3 direction = camLowerLeft + camHorizontal * s + camVertical * t - camOrigin - offset;
        sum += finiteOrBlack(trace(origin, direction));
    }
    // The earlier steps' frame holds the square root of their mean (gamma 2): back to linear, add, average.
    float3 earlier = float3(previous.eval(position).rgb);
    float taken = clamp(samples, 1.0, float(MAX_SAMPLES));
    float3 mean = (earlier * earlier * previousSamples + clamp(sum, 0.0, taken)) / (previousSamples + taken);
    float3 color = sqrt(clamp(mean, 0.0, 1.0));
    return half4(half3(min(color, float3(0.999))), 1.0);
}
