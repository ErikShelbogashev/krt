# A krt scene in pbrt-v4's format; #krt lines are krt's own, pbrt reads them as comments.
#krt Look "bool sampleLights" true "bool motionBlur" false
# pbrt's camera space is left-handed, krt's right-handed: the mirror keeps the picture the same.
Scale -1 1 1
LookAt 2.0 1.15 1.95  0.0 1.0 0.0  0 1 0
Camera "perspective" "float fov" 50.0 "float lensradius" 0.0 "float focaldistance" 2.7973201461398727
Film "rgb" "integer xresolution" 800 "integer yresolution" 600
Sampler "zsobol" "integer pixelsamples" 64
Integrator "volpath" "integer maxdepth" 12

WorldBegin
#krt Sky "rgb horizon" [0.004 0.004 0.006] "rgb zenith" [0.0 0.0 0.002]
LightSource "infinite" "rgb L" [0.002 0.002 0.004]
MakeNamedMedium "medium_0" "string type" "homogeneous" "rgb sigma_a" [0.003500000000000003 0.003500000000000003 0.003500000000000003] "rgb sigma_s" [0.0665 0.0665 0.0665] "float scale" 1

