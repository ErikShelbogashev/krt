  Translate -0.25 0.95 0.75
  Shape "sphere" "float radius" 0.24
AttributeEnd
AttributeBegin
  #krt Name "Bubble 5"
  #krt Material "soapbubble" "float thickness" 520.0 "float filmior" 1.33
  Material "thindielectric" "float eta" 1.33
  Translate 0.75 2.3 -0.9
  Shape "sphere" "float radius" 0.3
AttributeEnd
AttributeBegin
  #krt Name "Rising bubble"
  #krt Material "soapbubble" "float thickness" 420.0 "float filmior" 1.33
  Material "thindielectric" "float eta" 1.33
  Translate -0.55 2.05 -0.6
  ActiveTransform EndTime
  Translate 0.0 0.35 0.0
